# NextSignal local configuration — copy to .env (already included in this bundle)
DATABASE_URL=sqlite:///./nextsignal.db

# Live public prediction-market feeds. No API key is required for these read-only feeds.
ENABLE_LIVE_INGEST=true
AUTO_SEED=true
AUTO_SYNC=true
AUTO_SYNC_INTERVAL_MINUTES=5

# Frontend -> FastAPI backend
BACKEND_URL=http://127.0.0.1:8000
NEXT_PUBLIC_BACKEND_BASE=/api/backend

# Prevent the frontend from silently replacing live API failures with demo fixtures.
NEXT_PUBLIC_ALLOW_DEMO_FALLBACK=false

# Live adapters included: Polymarket Gamma and Kalshi public market listing.
# Historical odds, resolved outcomes, and calibrated forecasts are not fabricated in live mode.
